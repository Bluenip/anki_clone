# Environment Configuration for AnkiWeb Clone
# Generate a secure secret using: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_secure_random_secret_at_least_32_characters_long

# Environment mode: 'development' or 'production'
# In production, missing or default JWT_SECRET_KEY will fail-fast at startup.
APP_ENV=production

# Database & Storage
DATABASE_DIR=/data
CORS_ORIGINS=http://localhost:3456,http://localhost:5173

# Package imports (bytes). Defaults target a personal instance; lower for shared hosting.
ANKI_IMPORT_MAX_UPLOAD_BYTES=1073741824
ANKI_IMPORT_MAX_UNCOMPRESSED_BYTES=3221225472
ANKI_IMPORT_MAX_MEDIA_BYTES=2147483648
ANKI_IMPORT_MAX_SINGLE_MEDIA_BYTES=268435456
ANKI_IMPORT_MAX_CARDS=100000
ANKI_IMPORT_MAX_NOTES=100000
ANKI_IMPORT_MAX_MEDIA_FILES=100000
ANKI_IMPORT_MAX_ZIP_ENTRIES=100010
ANKI_IMPORT_MIN_FREE_BYTES=268435456
